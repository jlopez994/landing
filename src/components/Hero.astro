---
import { EMAIL, type Content } from "../i18n/content";

interface Props {
  t: Content["hero"];
}

const { t } = Astro.props;
---

<section id="top" class="hero">
  <p class="badge reveal">
    <span class="dot" aria-hidden="true"></span>{t.badge}
  </p>

  <h1 class="reveal">
    {t.title}{" "}
    <span class="accent">{t.titleAccent}</span>.
  </h1>

  <p class="lede reveal">{t.lede}</p>

  <div class="actions reveal">
    <a href="#work" class="btn btn-primary">{t.cta}</a>
    <a href={`mailto:${EMAIL}`} class="btn btn-ghost">{EMAIL}</a>
  </div>

  <dl class="stats reveal">
    {
      t.stats.map((s) => (
        <div class="stat">
          <dd>{s.v}</dd>
          <dt>{s.k}</dt>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100dvh - 61px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: min(3rem, 4vh) var(--space-gutter) min(2.5rem, 4vh);
  }

  .badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-line-accent);
    background: var(--color-accent-wash);
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    margin-bottom: min(1.7rem, 2.6vh);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .badge .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  h1 {
    font-size: var(--text-hero);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 52rem;
  }

  h1 .accent {
    color: var(--color-accent);
    white-space: nowrap;
  }

  .lede {
    margin-top: min(1.5rem, 2.4vh);
    max-width: 38rem;
    font-size: min(1.02rem, 2.7vh);
    line-height: 1.62;
    color: var(--color-mid);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: min(2.1rem, 3.2vh);
  }

  /* Hairline grid: 1px gaps over the border colour read as dividers */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
    gap: 1px;
    margin-top: min(clamp(2.2rem, 4.5vw, 3.4rem), 4.2vh);
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
  }

  .stat {
    background: var(--color-card);
    padding: min(1.15rem, 1.9vh) 1.35rem;
  }

  .stat dd {
    margin: 0;
    font-size: min(1.6rem, 3.4vh);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .stat dt {
    margin-top: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
    line-height: 1.4;
  }
</style>
