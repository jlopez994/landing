---
import type { Content } from "../i18n/content";

interface Props {
  t: Content["projects"];
}

const { t } = Astro.props;
---

<section id="work" class="section">
  <div class="section-head reveal">
    <span class="idx">01</span>
    <h2>{t.heading}</h2>
    <span class="rule"></span>
    <span class="meta">{t.meta}</span>
  </div>

  <div class="cards">
    {
      t.items.map((p, i) => {
        // Client work has no public repo, so it renders as a plain card
        const Tag = p.href ? "a" : "article";
        const linkProps = p.href
          ? { href: p.href, target: "_blank", rel: "noopener" }
          : {};
        return (
          <Tag class:list={["card", "reveal", { linked: p.href }]} style={`--i:${i % 3}`} {...linkProps}>
            <div class="card-meta">
              <span>
                {String(i + 1).padStart(2, "0")} · {p.year} · {p.scope}
              </span>
              <span class="metric">{p.metric}</span>
            </div>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
            <div class="tags">
              {p.tags.map((tag) => (
                <span class="chip">{tag}</span>
              ))}
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .section {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 3vw, 2.1rem);
    transition:
      border-color 600ms var(--ease-out-expo),
      transform 600ms var(--ease-out-expo),
      background 600ms var(--ease-out-expo);
  }

  .card:hover {
    border-color: var(--color-line-hover);
    background: var(--color-card-hover);
  }

  /* Only cards that go somewhere lift on hover */
  .card.linked:hover {
    transform: translateY(-3px);
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
  }

  .metric {
    color: var(--color-accent);
    border: 1px solid var(--color-line-accent);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  h3 {
    font-size: var(--text-card-title);
    max-width: 34rem;
  }

  .card p {
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-mid);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.2rem;
  }
</style>
