---
import type { Content } from "../i18n/content";

interface Props {
  t: Content["projects"];
}

const { t } = Astro.props;
---

<section id="work" class="section">
  <div class="section-head reveal">
    <span class="idx">01</span>
    <h2>{t.heading}</h2>
    <span class="rule"></span>
    <span class="meta">{t.meta}</span>
  </div>

  <div class="work-grid">
    <!-- Sticky panel: the architecture of whichever project is being read -->
    <aside class="panel" aria-hidden="true">
      <div class="panel-frame" data-frame>
        <div class="panel-grid"></div>
        {
          t.items.map((p, i) => (
            <div class="layer" data-layer>
              <div class="layer-head">
                <span>{p.arch.label}</span>
                <span>{String(i + 1).padStart(2, "0")}</span>
              </div>
              <ul class="nodes">
                {p.arch.nodes.map((n) => (
                  <li class="node" data-node>
                    <span class="node-box">
                      <span class="node-dot" />
                      <span class="node-t">{n.t}</span>
                      <span class="node-k">{n.k}</span>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    <div class="steps">
      {
        t.items.map((p, i) => (
          <article class="step" data-step>
            <div class="step-body">
              <div class="step-meta">
                <span>
                  {String(i + 1).padStart(2, "0")} · {p.year} · {p.scope}
                </span>
                <span class="metric">{p.metric}</span>
              </div>
              <h3>
                {/* Client work has no public repo, so only personal projects link out */}
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener">
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h3>
              <p>{p.body}</p>
              <div class="tags">
                {p.tags.map((tag) => (
                  <span class="chip">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
  }

  /* Stays a strip on phones: the text is what's being read, not the diagram */
  .panel {
    position: sticky;
    top: 3.9rem;
    height: clamp(11rem, 26vh, 13rem);
    z-index: 5;
  }

  .panel-frame {
    position: relative;
    height: 100%;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 18px;
    overflow: hidden;
  }

  .panel-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.7;
    background-image:
      linear-gradient(#14181c 1px, transparent 1px),
      linear-gradient(90deg, #14181c 1px, transparent 1px);
    background-size: 36px 36px;
  }

  .layer {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(0.9rem, 2.6vw, 1.9rem);
    opacity: 0;
    transition: opacity 700ms var(--ease-out-expo);
  }

  .layer.on {
    opacity: 1;
  }

  /* Without JS the walkthrough never runs, so the first diagram is the one on
     show. The first paint adds `.live`, taking that fallback back out. */
  .panel-frame:not(.live) .layer:first-of-type {
    opacity: 1;
  }

  .layer-head {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-dim);
  }

  .nodes {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Nodes ship visible so the diagram still reads without JS; the script dims them */
  .node {
    transition:
      opacity 600ms var(--ease-out-expo),
      transform 600ms var(--ease-out-expo);
  }

  .node.off {
    opacity: 0.16;
    transform: translateY(12px);
  }

  /* Connector stub between consecutive nodes, tinted once the flow has passed */
  .node:not(:last-child)::after {
    content: "";
    display: block;
    width: 1px;
    height: 0.4rem;
    margin-left: 1.1rem;
    background: var(--color-line);
    transition: background 600ms var(--ease-out-expo);
  }

  .node.on:not(.lead)::after {
    background: var(--color-line-hover);
  }

  /* Last revealed node — where the reader currently is in the flow */
  .node.lead .node-box {
    border-color: var(--color-line-hover);
    background: var(--color-card-hover);
  }

  /* Nothing is scrubbing here, so every node reads at full strength */
  @media (prefers-reduced-motion: reduce) {
    .node.off {
      opacity: 1;
      transform: none;
    }
  }

  .node-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-chip);
    border: 1px solid var(--color-line);
    border-radius: 8px;
    padding: 0.3rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    line-height: 1.35;
    color: var(--color-text-soft);
  }

  .node-dot {
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .node-t {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .node-k {
    margin-left: auto;
    color: var(--color-dim);
    white-space: nowrap;
  }

  .steps {
    display: flex;
    flex-direction: column;
  }

  /*
   * The step is the scroll band the walkthrough is paced against. Its height
   * comes from the copy plus a fixed gap rather than from a fixed band, so the
   * space between projects reads the same whatever the copy length; the
   * min-height is only a floor, so a short project still gets enough scroll
   * distance to walk through its diagram.
   */
  .step {
    display: flex;
    align-items: center;
    min-height: min(46vh, 19rem);
    padding-block: 1.8rem;
  }

  /* The rule marks the copy, so it is the copy's height. Hanging it off the
     scroll band instead left a 500px line beside 300px of text. */
  .step-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.65rem 0 0.65rem 1.15rem;
    border-left: 1px solid var(--color-line);
    transition: border-color 700ms var(--ease-out-expo);
  }

  /* Focus is carried by the accent rule and the title, not by fading the copy
     out: the step you are not on is still a step someone may be reading, and
     the 40% wash this replaces put the text below the AA contrast floor. */
  .step.on .step-body {
    border-left-color: var(--color-accent);
  }

  .step h3 {
    color: var(--color-mid);
    transition: color 700ms var(--ease-out-expo);
  }

  .step.on h3 {
    color: var(--color-text);
  }

  .step-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
  }

  .metric {
    color: var(--color-accent);
    border: 1px solid var(--color-line-accent);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }

  h3 {
    font-size: var(--text-card-title);
    max-width: 30rem;
  }

  h3 a {
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  h3 a:hover {
    color: var(--color-accent);
  }

  .step p {
    max-width: 34rem;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-mid);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.2rem;
  }

  @media (min-width: 56.25rem) {
    .work-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }

    /* Text leads on the left, the diagram tracks it on the right */
    .steps {
      order: 1;
    }

    /* Sized to sit level with a step's copy rather than towering over it */
    .panel {
      order: 2;
      top: 5.5rem;
      height: min(54vh, 22.5rem);
    }

    /* Diagram reads as a column, not a banner — the text keeps the wider half */
    .panel-frame {
      max-width: 25rem;
      margin-left: auto;
    }

    .steps .step {
      min-height: min(52vh, 22rem);
      padding-block: clamp(2rem, 5vh, 3.2rem);
    }

    .steps .step-body {
      padding-left: 1.5rem;
    }

    .node-box {
      gap: 0.65rem;
      border-radius: 10px;
      padding: 0.6rem 0.8rem;
      font-size: 0.72rem;
    }

    .node:not(:last-child)::after {
      height: 0.85rem;
      margin-left: 1.35rem;
    }
  }
</style>

<script>
  /**
   * Scrollytelling: a project takes the sticky diagram over the moment its
   * heading reaches the diagram's own top edge, and its nodes appear as that
   * project is read through.
   *
   * Handover is deliberately tied to the panel's sticky offset rather than to
   * a fraction of the viewport: the two then agree by construction, and the
   * switch lands where the eye already reads it — when the next heading
   * arrives beside the panel — at any step height.
   *
   * The scroll path reads nothing from the DOM. The handover positions are
   * measured once per layout, so a scroll frame is pure arithmetic — no forced
   * synchronous layout — and the DOM is written to only when the derived state
   * actually changes, which for most frames is never.
   */
  const steps = [...document.querySelectorAll<HTMLElement>("[data-step]")];
  const layers = [...document.querySelectorAll<HTMLElement>("[data-layer]")];
  const frame = document.querySelector<HTMLElement>("[data-frame]");
  const panel = document.querySelector<HTMLElement>(".panel");

  if (frame && panel && steps.length > 0 && steps.length === layers.length) {
    const nodesPerLayer = layers.map((layer) => [
      ...layer.querySelectorAll<HTMLElement>("[data-node]"),
    ]);

    /** Scroll position at which each project takes over, in document space. */
    let handovers: number[] = [];
    /** Scroll distance each project stays in charge for. */
    let spans: number[] = [];
    let paintedStep = -1;
    let paintedShown = -1;
    let rafId = 0;

    const measure = () => {
      const scrolled = window.scrollY;
      // `top` on a sticky element resolves to its offset, not its drawn
      // position, which is exactly the line a heading has to reach.
      const stickyTop = parseFloat(getComputedStyle(panel).top) || 0;

      handovers = steps.map((step) => {
        const heading = step.querySelector<HTMLElement>(".step-body") ?? step;
        return heading.getBoundingClientRect().top + scrolled - stickyTop;
      });

      const lastStep = steps[steps.length - 1].getBoundingClientRect();
      const end = lastStep.bottom + scrolled - stickyTop;
      spans = handovers.map((start, i) => Math.max(1, (handovers[i + 1] ?? end) - start));
    };

    const paint = () => {
      rafId = 0;
      if (handovers.length === 0) return;

      const scrolled = window.scrollY;

      let active = 0;
      for (let i = 1; i < handovers.length; i++) {
        if (scrolled >= handovers[i]) active = i;
      }

      const travelled = (scrolled - handovers[active]) / spans[active];
      const progress = Math.min(1, Math.max(0, travelled));
      const nodes = nodesPerLayer[active];
      const shown = Math.max(1, Math.ceil(progress * (nodes.length + 0.4)));

      if (active !== paintedStep) {
        steps.forEach((step, i) => step.classList.toggle("on", i === active));
        layers.forEach((layer, i) => layer.classList.toggle("on", i === active));
        frame.classList.add("live");
        paintedStep = active;
        paintedShown = -1;
      }

      if (shown !== paintedShown) {
        nodes.forEach((node, i) => {
          node.classList.toggle("on", i < shown);
          node.classList.toggle("off", i >= shown);
          node.classList.toggle("lead", i === shown - 1);
        });
        paintedShown = shown;
      }
    };

    const schedule = () => {
      if (!rafId) rafId = requestAnimationFrame(paint);
    };

    const remeasure = () => {
      measure();
      schedule();
    };

    // Every reflow that moves the steps — a resize, an orientation change, the
    // webfont swapping in — also changes the document height, so one observer
    // on the body catches all of them. Its first delivery is what measures the
    // page initially: it arrives after layout, where reading geometry is free,
    // whereas measuring eagerly here would force a synchronous one.
    new ResizeObserver(remeasure).observe(document.body);

    // Scroll work only runs while the walkthrough is on screen
    const section = steps[0].closest("section")!;
    new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          window.addEventListener("scroll", schedule, { passive: true });
          schedule();
        } else {
          window.removeEventListener("scroll", schedule);
        }
      }
    }).observe(section);
  }
</script>
