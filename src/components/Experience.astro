---
import type { Content } from "../i18n/content";

interface Props {
  t: Content["experience"];
}

const { t } = Astro.props;
---

<section id="exp" class="section">
  <div class="section-head reveal">
    <span class="idx">02</span>
    <h2>{t.heading}</h2>
    <span class="rule"></span>
    <span class="meta">{t.meta}</span>
  </div>

  <ol class="roles">
    {
      t.roles.map((r, i) => (
        <li class="role reveal" style={`--i:${i % 3}`}>
          <span class="years">{r.years}</span>
          <span class="title">
            {r.role} <span class="at">@ {r.company}</span>
          </span>
          <span class="stack">{r.stack}</span>
        </li>
      ))
    }
  </ol>

  <ul class="education reveal">
    {t.education.map((e) => <li>{e}</li>)}
  </ul>
</section>

<style>
  .section {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  .roles {
    list-style: none;
    padding: 0;
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2.4rem;
    align-items: baseline;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-line);
    transition: border-color var(--duration-normal) var(--ease-out-expo);
  }

  .role:hover {
    border-bottom-color: var(--color-line-hover);
  }

  .years {
    flex: 0 0 7.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-dim);
  }

  .title {
    flex: 1 1 18rem;
    font-size: 1.05rem;
    font-weight: 400;
  }

  .at {
    color: var(--color-accent);
  }

  .stack {
    flex: 1 1 20rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-mid);
  }

  .education {
    list-style: none;
    padding: 0;
    margin-top: 1.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
  }
</style>
