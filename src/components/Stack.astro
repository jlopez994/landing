---
const groups = [
  {
    label: "lenguajes",
    items: ["TypeScript", "JavaScript", "Java", "Python", "SQL"],
  },
  {
    label: "frontend",
    items: ["Angular", "NGRX", "React", "Next.js", "React Native", "Astro"],
  },
  {
    label: "backend",
    items: ["Spring Boot", "NestJS", "Node.js", "REST", "Socket.IO"],
  },
  {
    label: "datos",
    items: ["MySQL", "MongoDB", "Redis", "Firebase"],
  },
  {
    label: "infraestructura",
    items: ["Docker", "Kubernetes", "GitLab CI", "Jenkins", "AWS", "Debian"],
  },
  {
    label: "edge ml",
    items: ["openWakeWord", "ONNX", "Piper TTS", "pipelines de entrenamiento"],
  },
];
---

<section id="stack" class="section">
  <div class="section-head reveal">
    <span class="idx">03</span>
    <h2>Stack</h2>
    <span class="rule"></span>
    <span class="meta">día a día</span>
  </div>

  <div class="grid">
    {
      groups.map((g, i) => (
        <article class="card reveal" style={`--i:${i % 3}`}>
          <h3>{g.label}</h3>
          <ul>
            {g.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section {
    position: relative;
    max-width: var(--content-max);
    margin-inline: auto;
    padding: var(--space-section) var(--space-gutter);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1rem;
  }

  .card {
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.6rem;
    transition: border-color 600ms var(--ease-out-expo);
  }

  .card:hover {
    border-color: var(--color-line-hover);
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-accent);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }

  li {
    font-size: 0.94rem;
    color: var(--color-text-soft);
    background: var(--color-chip);
    border-radius: 7px;
    padding: 0.3rem 0.62rem;
  }
</style>
