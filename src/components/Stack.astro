---
import type { Content } from "../i18n/content";

interface Props {
  t: Content["stack"];
}

const { t } = Astro.props;
---

<section id="stack" class="section">
  <div class="section-head reveal">
    <span class="idx">03</span>
    <h2>{t.heading}</h2>
    <span class="rule"></span>
    <span class="meta">{t.meta}</span>
  </div>

  <div class="grid">
    {
      t.groups.map((g) => (
        <article class="card reveal">
          <h3>{g.label}</h3>
          <ul>
            {g.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>

<style>
  /*
   * Column counts are pinned rather than left to `auto-fit`, because eight
   * groups only tile cleanly at one, two or four across. An auto-fit track
   * settles on three at desktop widths and leaves the last row half empty.
   */
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 34rem) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 68rem) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .card {
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    padding: 1.5rem 1.6rem;
    transition: border-color 600ms var(--ease-out-expo);
  }

  .card:hover {
    border-color: var(--color-line-hover);
  }

  /* The AI group opens the list and carries the page's argument, so it is the
     one card given weight, instead of eight cards sharing the same emphasis */
  .card:first-child {
    border-color: var(--color-line-accent);
    background: linear-gradient(var(--color-accent-wash), transparent) var(--color-card);
  }

  /* Reveal stagger across a row, wrapping with the widest column count */
  .card:nth-child(4n + 2) {
    --i: 1;
  }

  .card:nth-child(4n + 3) {
    --i: 2;
  }

  .card:nth-child(4n) {
    --i: 3;
  }

  h3 {
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    font-weight: 400;
    letter-spacing: 0;
    color: var(--color-accent);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }

  li {
    font-size: 0.94rem;
    color: var(--color-text-soft);
    background: var(--color-chip);
    border-radius: 7px;
    padding: 0.3rem 0.62rem;
  }
</style>
