---
import { EMAIL, SOCIAL, type Content } from "../i18n/content";

interface Props {
  t: Content["contact"];
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<section id="contact" class="section">
  <div class="panel reveal">
    <div class="panel-glow" aria-hidden="true"></div>
    <div class="pitch">
      <h2>{t.heading}</h2>
      <p>{t.body}</p>
    </div>
    <div class="channels">
      <a href={`mailto:${EMAIL}`} class="btn btn-primary mail">{EMAIL}</a>
      <div class="social">
        {
          SOCIAL.map((l) => (
            <a href={l.href} target="_blank" rel="noopener">
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <footer>
    <span>© {year} Julián López Hervás</span>
    <span>{t.location}</span>
  </footer>
</section>

<style>
  /* Closing section gets extra air above and none below — the footer sits inside */
  .section {
    padding: clamp(3.5rem, 9vw, 7.5rem) var(--space-gutter) 0;
  }

  .panel {
    position: relative;
    overflow: hidden;
    background: var(--color-card);
    border: 1px solid var(--color-line);
    border-radius: 20px;
    padding: clamp(2rem, 5vw, 3.8rem);
    display: flex;
    flex-wrap: wrap;
    gap: 2.4rem;
    align-items: center;
    justify-content: space-between;
  }

  .panel-glow {
    position: absolute;
    inset: auto -10% -60% 40%;
    height: 22rem;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(124, 241, 180, 0.1),
      transparent 65%
    );
  }

  .pitch {
    position: relative;
    max-width: 28rem;
  }

  .pitch h2 {
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin-bottom: 0.9rem;
  }

  .pitch p {
    color: var(--color-mid);
    line-height: 1.65;
  }

  .channels {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 14rem;
  }

  .mail {
    text-align: center;
    overflow-wrap: anywhere;
  }

  .social {
    display: flex;
    gap: 1.3rem;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-dim);
  }

  .social a {
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .social a:hover {
    color: var(--color-accent);
  }

  footer {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: 1.4rem 0 2.4rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
  }
</style>
