---
import "../styles/tokens.css";
import "../styles/global.css";
import {
  content,
  languages,
  localeHref,
  EMAIL,
  NAME,
  OG_LOCALE,
  SOCIAL,
  type Lang,
} from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const nav = t.nav;

const pageUrl = new URL(localeHref(lang), Astro.site);
const ogImage = new URL("/og.png", Astro.site);

/**
 * Person schema — the machine-readable version of this page. Every field is
 * derived from the same content the page renders, so the two cannot drift.
 */
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: NAME,
  url: pageUrl.href,
  image: ogImage.href,
  email: `mailto:${EMAIL}`,
  jobTitle: t.meta.jobTitle,
  description: t.meta.description,
  sameAs: SOCIAL.map((s) => s.href),
  worksFor: { "@type": "Organization", name: t.experience.roles[0].company },
  address: {
    "@type": "PostalAddress",
    addressLocality: "Toledo",
    addressRegion: "Castilla-La Mancha",
    addressCountry: "ES",
  },
  knowsAbout: t.stack.groups.flatMap((g) => g.items),
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <meta name="author" content={NAME} />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localeHref(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link
      rel="preload"
      href="/fonts/sora-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="jlh.app" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a href="#content" class="skip">{nav.skip}</a>

    <div class="shell">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>

      <!-- Scroll progress: stands in for the rail on screens too narrow to show it -->
      <div class="flow" aria-hidden="true">
        <span class="flow-fill"></span>
        <span class="flow-head"></span>
      </div>

      <nav class="rail" aria-label={nav.railLabel}>
        {
          nav.rail.map((s) => (
            <a href={`#${s.id}`} data-rail={s.id}>
              <span class="bar" />
              {s.label}
            </a>
          ))
        }
      </nav>

      <header class="topbar">
        <a href="#top" class="brand">
          <span class="dot" aria-hidden="true"></span>jlh.app
        </a>
        <nav class="topnav" aria-label={nav.navLabel}>
          {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#contact" class="cta">{nav.cta}</a>
          <span class="langs" role="group" aria-label={nav.langLabel}>
            {
              languages.map((l) => (
                <a
                  href={localeHref(l)}
                  class:list={["lang", { on: l === lang }]}
                  hreflang={l}
                  aria-current={l === lang ? "true" : undefined}
                >
                  {l}
                </a>
              ))
            }
          </span>
        </nav>
      </header>

      <main id="content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-row">
          <span>© {new Date().getFullYear()} {NAME}</span>
          <span>{t.contact.location}</span>
        </div>
      </footer>
    </div>

    <script>
      // Scroll reveal. Reduced motion is handled in CSS, so this runs
      // unconditionally: the class still lands, the transition is a no-op.
      const revealIo = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("in");
            revealIo.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -10% 0px", threshold: 0.06 },
      );
      document.querySelectorAll(".reveal").forEach((el) => revealIo.observe(el));

      // Side rail: highlight the section occupying the middle band of the viewport
      const railLinks = document.querySelectorAll<HTMLElement>("[data-rail]");
      const sections = [...railLinks]
        .map((link) => document.getElementById(link.dataset.rail!))
        .filter((el): el is HTMLElement => el !== null);

      const setActive = (id: string) => {
        for (const link of railLinks) {
          const on = link.dataset.rail === id;
          link.classList.toggle("on", on);
          if (on) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      };

      const railIo = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.2, 0.6] },
      );
      sections.forEach((section) => railIo.observe(section));
      setActive("top");
    </script>
  </body>
</html>

<style>
  /* Keyboard-first escape hatch past the nav; off-screen until focused */
  .skip {
    position: fixed;
    top: 0.6rem;
    left: 0.6rem;
    z-index: 60;
    transform: translateY(-200%);
    padding: 0.6rem 1rem;
    border-radius: var(--radius-btn);
    background: var(--color-accent);
    color: var(--color-accent-ink);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
  }

  .skip:focus-visible {
    transform: none;
  }

  /* Sibling of <main>, so it reads as the page footer rather than a
     section's. The rule sits on the inner row to line up with the content
     column instead of running out into the gutter. */
  .site-footer {
    max-width: var(--content-max);
    margin-inline: auto;
    padding-inline: var(--space-gutter);
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-block: 1.4rem 2.4rem;
    border-top: 1px solid var(--color-line);
    font-family: var(--font-mono);
    font-size: var(--text-mono-sm);
    color: var(--color-dim);
  }

  .shell {
    position: relative;
    min-height: 100vh;
    /* Contains the oversized .glow so it never widens the viewport */
    overflow-x: clip;
  }

  /* Blueprint grid, faded out after the first screen — bounded so the painted
     layer stays viewport-sized instead of spanning the whole document */
  .grid-bg {
    position: absolute;
    inset: 0 0 auto;
    height: 150vh;
    pointer-events: none;
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(#000, transparent 70%);
    -webkit-mask-image: linear-gradient(#000, transparent 70%);
  }

  .glow {
    position: absolute;
    top: -24rem;
    left: 50%;
    transform: translateX(-58%);
    width: min(90rem, 150vw);
    height: 44rem;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(124, 241, 180, 0.09) 0%,
      rgba(124, 241, 180, 0.03) 34%,
      transparent 68%
    );
  }

  /*
   * Scroll progress bar, driven by a scroll timeline. No scroll listener, no
   * rAF loop and — the reason it was worth rewriting — no `scrollHeight` read
   * per scroll event forcing a synchronous layout. It stays hidden where the
   * timeline is unavailable: the rail already covers wide screens and the bar
   * is decorative, so nothing load-bearing depends on it.
   */
  .flow {
    position: fixed;
    /* Hugs the viewport edge so it never crowds the text in the gutter */
    left: 5px;
    top: 0;
    bottom: 0;
    width: 2px;
    z-index: 44;
    display: none;
    pointer-events: none;
    background: linear-gradient(
      rgba(35, 39, 45, 0),
      var(--color-line) 10%,
      var(--color-line) 90%,
      rgba(35, 39, 45, 0)
    );
  }

  @supports (animation-timeline: scroll()) {
    @media (max-width: 79.99rem) and (prefers-reduced-motion: no-preference) {
      .flow {
        display: block;
      }
    }
  }

  .flow-fill,
  .flow-head {
    position: absolute;
    inset: 0;
    animation-timeline: scroll(root block);
    animation-timing-function: linear;
    animation-fill-mode: both;
  }

  .flow-fill {
    transform: scaleY(0);
    transform-origin: top center;
    opacity: 0.7;
    background: linear-gradient(rgba(124, 241, 180, 0.15), var(--color-accent));
    animation-name: flow-fill;
  }

  @keyframes flow-fill {
    to {
      transform: scaleY(1);
    }
  }

  /*
   * The head dot rides the bottom edge of a full-height transparent box that
   * slides down the track. Translating that box rather than scaling it is what
   * keeps the dot round — a scaled parent would squash it into an ellipse.
   */
  .flow-head {
    transform: translateY(-100%);
    animation-name: flow-head;
  }

  .flow-head::after {
    content: "";
    position: absolute;
    left: -2.5px;
    bottom: -3.5px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 14px 3px rgba(124, 241, 180, 0.45);
  }

  @keyframes flow-head {
    from {
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .rail {
    position: fixed;
    left: 1.6rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 45;
    display: none;
    flex-direction: column;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 80rem) {
    .rail {
      display: flex;
    }
  }

  .rail a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-dim);
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .rail a:hover,
  .rail a.on {
    color: var(--color-accent);
  }

  .rail .bar {
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: width 600ms var(--ease-out-expo);
  }

  .rail a.on .bar {
    width: 34px;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--space-gutter);
    background: rgba(11, 12, 14, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.7rem);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-mid);
  }

  .topnav > a {
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .topnav > a:hover {
    color: var(--color-accent);
  }

  .topnav .cta {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    color: var(--color-text);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .topnav .cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .langs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.35rem;
    border-left: 1px solid var(--color-line);
  }

  .lang {
    text-transform: uppercase;
    font-size: 0.68rem;
    padding: 0.2rem 0.35rem;
    border-radius: 5px;
    color: var(--color-dim);
    transition:
      color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .lang:hover {
    color: var(--color-accent);
  }

  .lang.on {
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  /* Hide secondary nav links on small screens; the rail and CTA carry it */
  @media (max-width: 34rem) {
    .topnav > a:not(.cta) {
      display: none;
    }
  }
</style>
