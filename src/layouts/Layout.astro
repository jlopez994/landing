---
import "../styles/tokens.css";
import "../styles/global.css";
import { content, languages, localeHref, type Lang } from "../i18n/content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = content[lang];
const nav = t.nav;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(localeHref(lang), Astro.site)} />
    {
      languages.map((l) => (
        <link rel="alternate" hreflang={l} href={new URL(localeHref(l), Astro.site)} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <div class="shell">
      <div class="grid-bg" aria-hidden="true"></div>
      <div class="glow" aria-hidden="true"></div>

      <!-- Scroll progress: stands in for the rail on screens too narrow to show it -->
      <div class="flow" aria-hidden="true">
        <div class="flow-fill" id="flowFill"></div>
        <div class="flow-dot" id="flowDot"></div>
      </div>

      <nav id="rail" class="rail" aria-label={nav.railLabel}>
        {
          nav.rail.map((s) => (
            <a href={`#${s.id}`} data-rail={s.id}>
              <span class="bar" data-rail-bar></span>
              {s.label}
            </a>
          ))
        }
      </nav>

      <header class="topbar">
        <a href="#top" class="brand">
          <span class="dot" aria-hidden="true"></span>jlh.app
        </a>
        <nav class="topnav" aria-label={nav.navLabel}>
          {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="#contact" class="cta">{nav.cta}</a>
          <span class="langs" role="group" aria-label={nav.langLabel}>
            {
              languages.map((l) => (
                <a
                  href={localeHref(l)}
                  class:list={["lang", { on: l === lang }]}
                  hreflang={l}
                  aria-current={l === lang ? "true" : undefined}
                >
                  {l}
                </a>
              ))
            }
          </span>
        </nav>
      </header>

      <slot />
    </div>

    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const revealables = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduced) {
        revealables.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              io.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.06 },
        );
        revealables.forEach((el) => io.observe(el));
      }

      // Side rail: highlight the section occupying the middle of the viewport
      const railLinks = document.querySelectorAll<HTMLElement>("[data-rail]");
      const setActive = (id: string) => {
        railLinks.forEach((link) => {
          link.classList.toggle("on", link.dataset.rail === id);
        });
      };

      const tracked = [...railLinks]
        .map((link) => document.getElementById(link.dataset.rail!))
        .filter((el): el is HTMLElement => el !== null);

      const railIo = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) setActive(visible.target.id);
        },
        { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.2, 0.6] },
      );
      tracked.forEach((section) => railIo.observe(section));
      setActive("top");

      // Left progress bar: eased fill + dot, only where the rail is hidden
      const fill = document.getElementById("flowFill");
      const dot = document.getElementById("flowDot");

      if (fill && dot && !reduced) {
        const EASING = 0.09;
        let target = 0;
        let current = 0;
        let frame = 0;

        const step = () => {
          current += (target - current) * EASING;
          if (Math.abs(target - current) < 0.0004) current = target;
          fill.style.transform = `scaleY(${current.toFixed(4)})`;
          dot.style.top = `${(current * 100).toFixed(3)}%`;
          dot.style.opacity = current > 0.004 ? "1" : "0";
          frame = current === target ? 0 : requestAnimationFrame(step);
        };

        const read = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          target = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
          if (!frame) frame = requestAnimationFrame(step);
        };

        window.addEventListener("scroll", read, { passive: true });
        window.addEventListener("resize", read);
        read();
      }
    </script>
  </body>
</html>

<style>
  .shell {
    position: relative;
    min-height: 100vh;
    /* Contains the oversized .glow so it never widens the viewport */
    overflow-x: clip;
  }

  /* Blueprint grid, faded out after the first screen */
  .grid-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(var(--color-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-grid) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(#000, transparent 70%);
    -webkit-mask-image: linear-gradient(#000, transparent 70%);
  }

  .glow {
    position: absolute;
    top: -24rem;
    left: 50%;
    transform: translateX(-58%);
    width: min(90rem, 150vw);
    height: 44rem;
    pointer-events: none;
    background: radial-gradient(
      ellipse at center,
      rgba(124, 241, 180, 0.09) 0%,
      rgba(124, 241, 180, 0.03) 34%,
      transparent 68%
    );
  }

  .flow {
    position: fixed;
    left: 9px;
    top: 0;
    bottom: 0;
    width: 2px;
    z-index: 44;
    pointer-events: none;
    background: linear-gradient(
      rgba(35, 39, 45, 0),
      var(--color-line) 10%,
      var(--color-line) 90%,
      rgba(35, 39, 45, 0)
    );
  }

  .flow-fill {
    position: absolute;
    inset: 0;
    transform: scaleY(0);
    transform-origin: top center;
    opacity: 0.7;
    background: linear-gradient(rgba(124, 241, 180, 0.15), var(--color-accent));
  }

  .flow-dot {
    position: absolute;
    left: -2.5px;
    top: 0;
    width: 7px;
    height: 7px;
    margin-top: -3.5px;
    border-radius: 50%;
    opacity: 0;
    background: var(--color-accent);
    box-shadow: 0 0 14px 3px rgba(124, 241, 180, 0.45);
  }

  /* The rail takes over on wide screens, so the bar steps aside */
  @media (min-width: 80rem), (prefers-reduced-motion: reduce) {
    .flow {
      display: none;
    }
  }

  .rail {
    position: fixed;
    left: 1.6rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 45;
    display: none;
    flex-direction: column;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (min-width: 80rem) {
    .rail {
      display: flex;
    }
  }

  .rail a {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--color-dim);
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .rail a:hover,
  .rail a.on {
    color: var(--color-accent);
  }

  .rail .bar {
    width: 14px;
    height: 1px;
    background: currentColor;
    transition: width 600ms var(--ease-out-expo);
  }

  .rail a.on .bar {
    width: 34px;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem var(--space-gutter);
    background: rgba(11, 12, 14, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse 2.6s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  .topnav {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2vw, 1.7rem);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--color-mid);
  }

  .topnav > a {
    transition: color var(--duration-normal) var(--ease-out-expo);
  }

  .topnav > a:hover {
    color: var(--color-accent);
  }

  .topnav .cta {
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    color: var(--color-text);
    transition:
      border-color var(--duration-normal) var(--ease-out-expo),
      color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .topnav .cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  .langs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.35rem;
    border-left: 1px solid var(--color-line);
  }

  .lang {
    text-transform: uppercase;
    font-size: 0.68rem;
    padding: 0.2rem 0.35rem;
    border-radius: 5px;
    color: var(--color-dim);
    transition:
      color var(--duration-normal) var(--ease-out-expo),
      background var(--duration-normal) var(--ease-out-expo);
  }

  .lang:hover {
    color: var(--color-accent);
  }

  .lang.on {
    color: var(--color-accent);
    background: var(--color-accent-wash);
  }

  /* Hide secondary nav links on small screens; the rail and CTA carry it */
  @media (max-width: 34rem) {
    .topnav > a:not(.cta) {
      display: none;
    }
  }
</style>
